// Vertex shader
const vertexShaderSource = `
attribute vec3 vertex;
attribute vec3 normal;
attribute vec3 tangent;
attribute vec2 tex;

uniform mat4 ModelViewMatrix;
uniform mat4 ProjectionMatrix;
uniform mat3 NormalMatrix;

varying vec3 vNormal;
varying vec3 vTangent;
varying vec3 vPosition;
varying vec2 vTexCoord;

void main() {
    vec4 vertexPos = ModelViewMatrix * vec4(vertex, 1.0);
    vPosition = vertexPos.xyz;
    vNormal = NormalMatrix * normal;
    vTangent = NormalMatrix * tangent;
    vTexCoord = tex;
    gl_Position = ProjectionMatrix * vertexPos;
}`;

// Fragment shader
const fragmentShaderSource = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
   precision highp float;
#else
   precision mediump float;
#endif

uniform vec4 color;
uniform vec3 lightPosEye;
uniform bool isLight;

uniform sampler2D iTMU0; // Diffuse texture
uniform sampler2D iTMU1; // Specular texture
uniform sampler2D iTMU2; // Normal texture

varying vec3 vNormal;
varying vec3 vTangent;
varying vec3 vPosition;
varying vec2 vTexCoord;

void main() {
    if (isLight) {
        gl_FragColor = color;
        return;
    }

    // Gram-Schmidt orthogonalization prioritizing tangent
    vec3 T = normalize(vTangent);
    vec3 N = normalize(vNormal);
    N = normalize(N - dot(N, T) * T);
    vec3 B = normalize(cross(N, T));
    mat3 TBN = mat3(T, B, N);

    // Sample normal map and transform from tangent space to eye space
    vec3 normalMap = texture2D(iTMU2, vTexCoord).rgb * 2.0 - 1.0;
    vec3 finalNormal = normalize(TBN * normalMap);

    vec3 L = normalize(lightPosEye - vPosition);

    // Sample diffuse and specular textures
    vec3 diffuseMap = texture2D(iTMU0, vTexCoord).rgb;
    vec3 specularMap = texture2D(iTMU1, vTexCoord).rgb;

    // Ambient
    float ambientIntensity = 0.25;
    vec3 ambient = diffuseMap * ambientIntensity;

    // Diffuse
    float diffuseIntensity = max(dot(finalNormal, L), 0.0);
    vec3 diffuse = diffuseMap * diffuseIntensity;

    // Specular
    vec3 V = vec3(0.0, 0.0, 1.0);
    vec3 R = reflect(-L, finalNormal);
    float specularIntensity = pow(max(dot(R, V), 0.0), 32.0);
    vec3 specular = specularMap * specularIntensity;

    vec3 finalColor = ambient + diffuse + specular;
    gl_FragColor = vec4(finalColor, color.a);
}`;